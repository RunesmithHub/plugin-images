### The Images plugin's text in English, the source every translation starts from. The build turns each message into a member of the
### Strings class, such as Strings.ImageViewer.

# The editor's name, as Open With lists it.
image-viewer = Image Viewer

## The buttons above the image, with their keys.

zoom-out = Zoom out (-)
zoom-in = Zoom in (+)
fit = Fit
fit-tip = Fit in the window (0)
actual-size-tip = Actual size (1)
